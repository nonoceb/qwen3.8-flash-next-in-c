#version 450

// Q8_0 quantized GEMV kernel
// Block size: 32 elements per block with 1 fp16 scale + 32 int8 weights
// Total block size: 34 bytes (2 for scale + 32 for weights)

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Weights {
    uint weights_packed[];  // Packed Q8_0 blocks
};

layout(set = 0, binding = 1) readonly buffer InputVec {
    float input_vec[];
};

layout(set = 0, binding = 2) writeonly buffer OutputVec {
    float output_vec[];
};

layout(push_constant) uniform Params {
    uint M;           // Number of rows (output dimension)
    uint N;           // Number of columns (input dimension)
    uint blocks_per_row;  // Number of blocks per row (N / 32)
} pc;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.M) return;
    
    float sum = 0.0;
    
    // Each block has 32 values
    // Block format: [scale: fp16][weights: 32 int8]
    // Total block size: 34 bytes
    
    for (uint block = 0; block < pc.blocks_per_row; block++) {
        // Calculate byte offset for this block
        uint byte_offset = row * pc.blocks_per_row * 34u + block * 34u;
        uint uint_offset = byte_offset / 4u;
        
        // Read scale (fp16 stored as first 2 bytes)
        uint scale_packed = weights_packed[uint_offset];
        float scale = unpackHalf2x16(scale_packed).x;
        
        // Process 32 int8 weights
        // They start at byte offset 2 and span 32 bytes
        uint weight_byte_offset = byte_offset + 2u;
        
        for (uint i = 0; i < 8u; i++) {  // 8 uints = 32 int8 values
            uint packed = weights_packed[uint_offset + 1u + i];
            
            // Extract 4 int8 values from each uint
            for (uint j = 0; j < 4u; j++) {
                uint col_idx = block * 32u + i * 4u + j;
                if (col_idx >= pc.N) break;
                
                // Extract int8 value (signed)
                int weight_i8 = int(packed >> (j * 8u)) & 0xFF;
                if (weight_i8 > 127) weight_i8 -= 256;  // Convert to signed
                
                float weight = float(weight_i8) * scale;
                sum += weight * input_vec[col_idx];
            }
        }
    }
    
    output_vec[row] = sum;
}
